[TEMPLATE]
# Search API (Tavily)
TAVILY_API_KEY=tvly-...

# LLM Tier 2 (Gemini Flash via Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# LLM Tier 3 (Groq API for llama-3.1-70b-versatile or Gemini Pro)
GROQ_API_KEY=gsk_...

# LLM Tier 1 (Local Ollama, optional - falls back gracefully to Gemini Flash if not running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Database URL
# For local dev without Postgres: sqlite+aiosqlite:///./research_agent.db
# For PostgreSQL / Railway: postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent
DATABASE_URL=sqlite+aiosqlite:///./research_agent.db

# Redis Cache URL (optional for local, falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# API Security (Static key header check: X-API-Key)
API_KEY=dev_api_key_jev_ikf_2026

# App Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_RESEARCH_TIME_MINUTES=10
MAX_QUERIES_PER_SESSION=50
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (browser-visible) API access. NEXT_PUBLIC_API_KEY must match API_KEY above.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# NEXT_PUBLIC_API_KEY=dev_api_key_jev_ikf_2026
